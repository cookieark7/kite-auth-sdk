# Copy to .env and fill in real values. Never commit a populated .env.
# The TOTP secret is password-equivalent — treat it like a credential.
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret
KITE_USER_ID=your_user_id
KITE_PASSWORD=your_password
KITE_TOTP_SECRET=your_base32_totp_secret

HEADLESS=true
SESSION_STORE=json
LOG_LEVEL=INFO

# Login safety knobs (optional; sane defaults shown)
# MAX_LOGIN_ATTEMPTS=3
# TOTP_MIN_VALIDITY_SECONDS=8
# MAX_CLOCK_DRIFT_SECONDS=5
# CLOCK_DRIFT_HARD_FAIL=false
